{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "HackerOne Dark",
  "author": "Sanjaymenon <support+zed@sanjaymenon.xyz>",
  "themes": [
    {
      "name": "HackerOne Dark",
      "appearance": "dark",
      "style": {
        "background.appearance": "opaque",
        "accents": [],
        "border": "#5c5e6a",
        "border.variant": "#5c5e6a",
        "border.focused": "#ff5ca8",
        "border.selected": "#5c5e6a",
        "border.transparent": "#5c5e6a",
        "border.disabled": "#5c5e6a",
        "elevated_surface.background": "#0a0a0a",
        "surface.background": "#0a0a0a",
        "background": "#0a0a0a",
        "element.background": "#7aa2ff",
        "element.hover": "#002375",
        "element.selected": "#61002d",
        "drop_target.background": "#292b33",
        "ghost_element.hover": "#002375",
        "ghost_element.selected": "#61002d",
        "text": "#ffffff",
        "text.muted": "#d6d7dd",
        "status_bar.background": "#3a3c45",
        "title_bar.background": "#0a0a0a",
