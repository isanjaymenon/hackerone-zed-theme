          },
          "comment.doc": {
            "color": "#92959e",
            "font_style": "italic"
          },
          "constant": {
            "color": "#ffb187"
          },
          "constructor": {
            "color": "#ffd482"
          },
          "emphasis": {
            "color": "#ff5ca8"
          },
          "emphasis.strong": {
            "color": "#ffb187"
          },
          "function": {
            "color": "#61afef"
          },
          "keyword": {
            "color": "#ff5ca8"
          },
          "number": {
            "color": "#ffb187"
          },
          "operator": {
            "color": "#ffffff"
          },
          "property": {
            "color": "#ffffff"
          },
          "string": {
            "color": "#b2ffe6"
          },
          "string.escape": {
            "color": "#b2ffe6"
          },
          "string.regex": {
            "color": "#b2ffe6"
          },
          "string.special": {
            "color": "#ffc2de"
          },
          "string.special.symbol": {
            "color": "#ffc2de"
          },
          "tag": {
            "color": "#ffd482"
          },
          "text.literal": {
